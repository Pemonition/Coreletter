# Copie para secrets.env (ignorado pelo Git) e troque a senha nas DUAS linhas.
# Só para cluster local de estudo: nunca use senha pessoal nem publique o secrets.env.
POSTGRES_PASSWORD=troque-esta-senha-local
ConnectionStrings__Default=Host=postgres;Port=5432;Database=coreletter;Username=coreletter;Password=troque-esta-senha-local
