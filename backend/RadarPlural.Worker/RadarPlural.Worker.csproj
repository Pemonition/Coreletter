<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RadarPlural.Ingestion\RadarPlural.Ingestion.csproj" />
    <PackageReference Include="Npgsql" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mesma conversão de URL postgresql:// usada pela API, sem duplicar código nem referenciar o projeto web. -->
    <Compile Include="..\RadarPlural.Api\DatabaseUrl.cs" Link="DatabaseUrl.cs" />
    <None Update="fontes.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RadarPlural.Pipeline\RadarPlural.Pipeline.csproj" />
    <ProjectReference Include="..\RadarPlural.Infrastructure\RadarPlural.Infrastructure.csproj" />
  </ItemGroup>

</Project>
